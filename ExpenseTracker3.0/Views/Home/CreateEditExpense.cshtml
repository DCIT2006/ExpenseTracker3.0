@{
    ViewData["Title"] = "Create / Edit";
}

@model ExpenseTracker3._0.Models.Expense

<div class="text-center">
    <h1 class="display-4">
        Create or edit an expense
    </h1>
</div>




<form asp-action="CreateEditExpenseForm" asp-controller="Home">
    <input hidden class="form-control" type="number" placeholder="0" asp-for="Id" />

    <label class="mt-4">$ Value</label>
    <input id="valueInput" input class="form-control" type="number" required asp-for="Value" step="0.01" min="0" />
  

    <label class="mt-4">Description</label>
    <input id="descriptionInput "input class="form-control" type="text" required placeholder="Add a description" asp-for="Description" />

    <label class="mt-4">Type of Expense</label>
    <select id="expenseTypeSelect" class="form-control" asp-for="ExpenseType" asp-items="ViewBag.ExpenseTypes" required>
        <option value="">Select Expense Type</option>
    </select>

    <label class="mt-4">Date</label>
    <input class="form-control" type="date" required asp-for="ExpenseDate" />


    <button class="btn btn-primary" type="submit">Ok</button>
</form>
