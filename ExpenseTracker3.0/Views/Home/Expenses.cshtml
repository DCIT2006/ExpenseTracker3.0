@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Expenses";
}

@model List<Expense>

<div class="text-center">
    <h1 class="display-4">Expenses</h1>
    <br />
    <hr />
    <h3>Total expenses $@ViewBag.Expenses</h3>
    <br />



    <table class="table">
        <thead>
            <tr>
                <th>Date</th> 
                <th>Value</th>
                <th>Description</th>
                <th>Type</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var expense in Model)
            {
                <tr>
                    <td>@expense.ExpenseDate.ToString("MM/dd/yyyy")</td>
                    <td>@expense.Value</td>
                    <td>@expense.Description</td>
                    <td>@expense.ExpenseType</td>
                    <td>
                        <a class="btn btn-success" asp-action="CreateEditExpense" asp-route-id="@expense.Id">
                        <img src = "~/images/296940.png" alt="Edit" style="width: 20px; height: 20px" />
                        </a>
                        <button type="button" class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#deleteModal" data-id="@expense.Id">
                            <img src="~/images/6861362.png" alt="Delete" style="width: 20px; height: 20px" />
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>


<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="deleteModalLabel">Confirm Deletion</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <span style="color: red;">Are you sure you want to delete this expense?</span>
                <input type="hidden" name="__RequestVerificationToken" value="@ViewBag.RequestVerificationToken" />                
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-secondary" id="confirmDeleteButton" style="background: black; border: none;">
                    <img src="~/images/6861362.png" alt="TrashCan" style="width: 20px; height: 20px;" />
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    var deleteExpenseId = 0;

    document.addEventListener('DOMContentLoaded', function () {
        var deleteModal = document.getElementById('deleteModal');
        deleteModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            deleteExpenseId = button.getAttribute('data-id');
        });

        var confirmDeleteButton = document.getElementById('confirmDeleteButton');
        confirmDeleteButton.addEventListener('click', function () {
            fetch(`/Home/DeleteExpense/${deleteExpenseId}`, {
                method: 'DELETE',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                }
            })
            .then(response => {
                if (response.ok) {
                    console.log('Expense deleted successfully');
                    document.querySelector(`button[data-id="${deleteExpenseId}"]`).closest('tr').remove();
                } else {
                    console.error('Failed to delete expense');
                }
                var modal = bootstrap.Modal.getInstance(deleteModal);
                modal.hide();
            })
            .catch(error => {
                console.error('Error:', error);
            });
        });
    });
</script>


